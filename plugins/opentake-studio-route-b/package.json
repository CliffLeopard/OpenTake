{
  "name": "@opentake/studio-route-b",
  "version": "0.1.0",
  "private": true,
  "description": "OpenTake Studio Route B: Rust engine as an in-process N-API addon inside DeepSeek Harness.",
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js"
  },
  "files": [
    "index.js",
    "client.js",
    "ui/**",
    "cordis.patch.yml",
    "web/**",
    "native/*/*.node",
    "README.md",
    "lib/motion-templates.js",
    "lib/providers.js"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  }
}
